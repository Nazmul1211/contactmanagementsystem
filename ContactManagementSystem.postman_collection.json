{
  "info": {
    "_postman_id": "c8a148d2-5a9e-4e4b-91f8-8bbca6899723",
    "name": "Contact Management API",
    "description": "Postman collection containing only the essential contact CRUD operations under /api/contacts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "contactId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Contact",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "if (data && data.id) {",
              "    pm.collectionVariables.set('contactId', data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+1-555-0199\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/contacts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contacts"]
        }
      },
      "response": []
    },
    {
      "name": "Get All Contacts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/contacts",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contacts"]
        }
      },
      "response": []
    },
    {
      "name": "Get Contact by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contacts", "{{contactId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Update Contact",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Johnathan Doe\",\n  \"email\": \"johnathan.doe@example.com\",\n  \"phone\": \"+1-555-9999\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contacts", "{{contactId}}"]
        }
      },
      "response": []
    },
    {
      "name": "Delete Contact",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/contacts/{{contactId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "contacts", "{{contactId}}"]
        }
      },
      "response": []
    }
  ]
}
